{
  "name": "Plantilla BAP - Verde y Naranja",
  "version": "7.4",
  "description": "Plantilla monetaria basada en los fondos PNG de Canva (V4.0): indicadores nuevos con icono (2 a 5 con fotos, 1 a 4 grandes), logo del programa junto al título, tres diseños de página de cierre (ondas y corazones, marco verde, hexágonos), fuente Avenir incrustable y tamaño de fuente manual opcional.",
  "entry": "report.html",
  "stylesheet": "style.css",
  "cover_variants": [
    "cover_1",
    "cover_2"
  ],
  "page_types": [
    {
      "id": "text_photos",
      "label": "Texto + 3 fotografías",
      "photos": 3,
      "min_photos": 3,
      "max_photos": 3,
      "text_min": 40,
      "text_max": 500
    },
    {
      "id": "mixed_photos",
      "label": "Texto + fotografías de distintos tamaños",
      "photos": 3,
      "min_photos": 3,
      "max_photos": 3,
      "text_min": 40,
      "text_max": 450,
      "orientations": [
        "vertical",
        "cuadrada",
        "horizontal"
      ]
    },
    {
      "id": "results_photos",
      "label": "Resultados + fotografías",
      "photos": 3,
      "min_photos": 3,
      "max_photos": 3,
      "indicators_min": 1,
      "indicators_max": 4,
      "text_min": 30,
      "text_max": 350
    },
    {
      "id": "results_numbers",
      "label": "Resultados numéricos",
      "photos": 0,
      "min_photos": 0,
      "max_photos": 0,
      "indicators_min": 1,
      "indicators_max": 4,
      "text_min": 20,
      "text_max": 300
    },
    {
      "id": "gallery",
      "label": "Galería de fotografías",
      "gallery_counts": [
        6,
        9,
        12
      ],
      "text_min": 0,
      "text_max": 0
    }
  ],
  "limits": {
    "title_min": 3,
    "title_max": 70,
    "indicator_value_min": 1,
    "indicator_value_max": 25,
